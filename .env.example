# =============================================
# A股短线交易AI辅助驾驶舱 - 环境变量配置
# =============================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ----- Supabase（必填，从扣子集成管理页面获取）-----
COZE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
COZE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# COZE_SUPABASE_SERVICE_ROLE_KEY=eyJxxx  # 可选，有更高权限

# ----- 大模型 API（必填，AI分析功能需要）-----
# 推荐用 DeepSeek（注册送 500 万 token）：https://platform.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com    # 可选，默认 DeepSeek
# LLM_MODEL=deepseek-chat                   # 可选，默认 deepseek-chat

# 也可用 OpenAI 兼容的任何 API：
# LLM_BASE_URL=https://api.openai.com
# LLM_MODEL=gpt-4o-mini

# ----- 运行环境 -----
NODE_ENV=production
PORT=5000
# SQLite 数据库路径：部署到 Railway/Render 等容器平台时必须指向挂载的持久卷路径，
# 否则每次重新部署数据（卡密/用户/日志）会全部丢失
DB_PATH=/data/ai-video-tool.db

# =============================================
# 卡密制 AI 工具站 - 环境变量（复制到 .env 使用）
# =============================================
# ----- 安全（生产必填）-----
# JWT 签名密钥（openssl rand -hex 32 生成；生产未配置将拒绝启动）
JWT_SECRET=
# 敏感配置加密主密钥（openssl rand -hex 32 生成；配置后后台保存的 AI API Key 以 AES-256-GCM 加密落库）
CONFIG_ENCRYPTION_KEY=
# 信任的反向代理层数：0=直连部署（不信任 XFF 头）；1=单层反代（默认，Railway/Render/Nginx）
TRUST_PROXY=1

# ----- 管理后台（首次初始化时创建，上线后请立即改密码）-----
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456

# ----- 业务参数（可选，均有默认值）-----
# DAILY_LIMIT=20              # 卡密默认每日生成上限
# CARD_VALID_DAYS=30          # 卡密默认有效期（天）
# CARD_PER_MINUTE_LIMIT=5     # 单卡密每分钟请求上限
# TZ_OFFSET_HOURS=8           # 每日配额重置时区（中国 UTC+8）

# ----- AI 服务商（任选一家或多家的环境变量注入；也可在管理后台填写）-----
# DASHSCOPE_API_KEY=          # 通义千问
# ZHIPU_API_KEY=              # 智谱AI
# DEEPSEEK_API_KEY=           # DeepSeek
# HUNYUAN_API_KEY=            # 腾讯混元
# DOUBAO_API_KEY=             # 字节豆包
# SILICONFLOW_API_KEY=        # 硅基流动
