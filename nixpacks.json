{
  "$schema": "https://nixpacks.com/schema.json",
  "aptPackages": ["build-essential", "python3"],
  "phases": {
    "install": {
      "commands": ["npm install -g node-gyp@10", "pnpm install --frozen-lockfile --prefer-offline"]
    }
  },
  "start": "NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--max-old-space-size=512' node dist/startup.js"
}
