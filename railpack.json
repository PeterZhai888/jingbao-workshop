{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": ["...", "build-essential", "python3"],
  "steps": {
    "install": {
      "commands": [
        "npm install -g node-gyp@10",
        "pnpm install --frozen-lockfile --prefer-offline"
      ]
    },
    "build": {
      "commands": [
        "pnpm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--max-old-space-size=512' node dist/startup.js"
  }
}
